#!/usr/bin/env node

/**
 * Portal — a web-based coding agent.
 *
 * Launches the web UI server (delegates to scripts/start-web.ts via Bun).
 */

import { spawn } from 'node:child_process'
import { join, dirname } from 'node:path'
import { fileURLToPath } from 'node:url'

const __dirname = dirname(fileURLToPath(import.meta.url))
const startWeb = join(__dirname, '..', 'scripts', 'start-web.ts')

const child = spawn('bun', ['run', startWeb, ...process.argv.slice(2)], {
  stdio: 'inherit',
})

child.on('exit', code => process.exit(code ?? 0))
