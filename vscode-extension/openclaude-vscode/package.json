{
  "name": "portal-vscode",
  "displayName": "Portal",
  "description": "Practical VS Code companion for Portal with project-aware launch behavior and a real Control Center.",
  "version": "0.1.1",
  "publisher": "devnull-bootloader",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Themes",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:portal.start",
    "onCommand:portal.startInWorkspaceRoot",
    "onCommand:portal.openDocs",
    "onCommand:portal.openSetupDocs",
    "onCommand:portal.openWorkspaceProfile",
    "onCommand:portal.openControlCenter",
    "onView:portal.controlCenter"
  ],
  "main": "./src/extension.js",
  "files": [
    "README.md",
    "media/**",
    "src/extension.js",
    "src/presentation.js",
    "src/state.js",
    "themes/**"
  ],
  "contributes": {
    "commands": [
      {
        "command": "portal.start",
        "title": "Portal: Launch in Terminal",
        "category": "Portal"
      },
      {
        "command": "portal.startInWorkspaceRoot",
        "title": "Portal: Launch in Workspace Root",
        "category": "Portal"
      },
      {
        "command": "portal.openDocs",
        "title": "Portal: Open Repository",
        "category": "Portal"
      },
      {
        "command": "portal.openSetupDocs",
        "title": "Portal: Open Setup Guide",
        "category": "Portal"
      },
      {
        "command": "portal.openWorkspaceProfile",
        "title": "Portal: Open Workspace Profile",
        "category": "Portal"
      },
      {
        "command": "portal.openControlCenter",
        "title": "Portal: Open Control Center",
        "category": "Portal"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "portal",
          "title": "Portal",
          "icon": "media/portal.svg"
        }
      ]
    },
    "views": {
      "portal": [
        {
          "id": "portal.controlCenter",
          "name": "Control Center",
          "type": "webview"
        }
      ]
    },
    "configuration": {
      "title": "Portal",
      "properties": {
        "portal.launchCommand": {
          "type": "string",
          "default": "portal",
          "description": "Command run in the integrated terminal when launching Portal."
        },
        "portal.terminalName": {
          "type": "string",
          "default": "Portal",
          "description": "Integrated terminal tab name for Portal sessions."
        },
        "portal.useOpenAIShim": {
          "type": "boolean",
          "default": false,
          "description": "Optionally set CLAUDE_CODE_USE_OPENAI=1 in launched Portal terminals."
        }
      }
    },
    "themes": [
      {
        "label": "Portal Terminal Black",
        "uiTheme": "vs-dark",
        "path": "./themes/Portal-Terminal-Black.json"
      }
    ]
  },
  "scripts": {
    "test": "node --test ./src/*.test.js",
    "lint": "node -e \"for (const file of require('node:fs').readdirSync('./src')) { if (file.endsWith('.js')) { require('node:child_process').execFileSync(process.execPath, ['--check', require('node:path').join('src', file)], { stdio: 'inherit' }); } }\"",
    "package": "npx @vscode/vsce package --no-dependencies"
  },
  "keywords": [
    "portal",
    "terminal",
    "theme",
    "cli",
    "llm"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/DavidCiallo/portal"
  },
  "license": "MIT"
}
